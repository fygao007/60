{
  "name": "wisedu-ui-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:edit-overlay-spec": "node ./scripts/generate-edit-overlay-spec.mjs",
    "build:previews": "npm run generate:edit-overlay-spec && node ./scripts/build-react-previews.mjs",
    "validate:framework2": "node ./framework/validate-framework-2.mjs",
    "validate:links": "node ./validate-local-links.mjs",
    "validate:edit-overlays": "node ./scripts/validate-edit-overlay-contract.mjs",
    "validate:no-overlay-internals": "node ./scripts/validate-no-new-overlay-internals.mjs",
    "validate": "npm run build:previews && npm run validate:links && npm run validate:framework2 && npm run validate:edit-overlays && npm run validate:no-overlay-internals",
    "test:edit-overlays": "npm run build:previews && node ./scripts/verify-edit-overlay-visual.mjs",
    "test:edit-overlays:update": "npm run build:previews && node ./scripts/verify-edit-overlay-visual.mjs --update"
  },
  "dependencies": {
    "lit": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.5",
    "pixelmatch": "^7.1.0",
    "playwright-core": "^1.52.0",
    "pngjs": "^7.0.0"
  }
}
